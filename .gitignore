# 루트 모노레포 .gitignore
# 각 하위 프로젝트(ddarahakit_backend, ddarahakit_frontend)의 .gitignore 가
# 빌드 산출물/비밀값(.env, keystore, node_modules 등)을 개별적으로 처리한다.

# MSA 모노레포 Gradle 산출물 (gradle/wrapper/*.jar 는 추적 유지)
.gradle/
/build/
common/build/
infra/discovery/build/
infra/gateway/build/
services/*/build/

# OS
.DS_Store
Thumbs.db

# 에디터/IDE
.idea/
.vscode/
*.iml

# 로그
*.log

# 배포 비밀값/인증서 (.env.example 은 추적, 실제 .env 와 인증서는 미추적)
.env

# 배포 설정 폴더 전체 미추적 (깃헙에 올리지 않음)
deploy/

# 배포용 compose 파일 미추적 (깃헙에 올리지 않음)
docker-compose.yml

# 파이(라즈베리) 로컬 배포 스크래치 — DB 덤프/jar/dist/비밀값·SQL 포함, 절대 추적 금지
_pi/

# 루트 services 빌드 산출물
/services/build/
